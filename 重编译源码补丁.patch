diff -ruN Compositor.orig/Document/BrushStroke.swift Compositor.current/Document/BrushStroke.swift
--- Compositor.orig/Document/BrushStroke.swift	2026-11-08 01:47:52
+++ Compositor.current/Document/BrushStroke.swift	2026-11-09 02:43:41
@@ -837,6 +837,18 @@
         }
     }
 
+    /// Erases everything inside the closed outline (document coordinates) to transparency —
+    /// the plugin tear's cut: the outline straddles the selection box it grew from, and its
+    /// ragged edge is where the layer reads as torn.
+    func cutWithOutline(_ outline: CGPath) throws {
+        try paintCanvas(withinSource: true) { context in
+            context.setBlendMode(.destinationOut)
+            context.setFillColor(gray: 0, alpha: 1)
+            context.addPath(outline)
+            context.fillPath()
+        }
+    }
+
     /// Runs `draw` in document coordinates over every tile the canvas and selection
     /// cover (only the layer's existing pixels with `withinSource`), clipped to both,
     /// starting from each tile's original content.
